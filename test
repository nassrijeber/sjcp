import static org.apache.spark.sql.functions.*;

import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;
import org.apache.spark.sql.SparkSession;

public class ReadOnlyLatestPartition {

    public static void main(String[] args) {
        SparkSession spark = SparkSession.builder()
                .appName("Read only latest partition")
                .getOrCreate();

        String basePath = "s3://mon-bucket/Raw_data/clarity/taxonomy";

        Dataset<Row> partitionsDf = spark.read()
                .option("basePath", basePath)
                .option("header", "true")
                .option("inferSchema", "true")
                .csv(basePath)
                .select("type_taxonomy", "date")
                .distinct()
                .withColumn("date", to_date(col("date"), "yyyy-MM-dd"));

        Row maxDateRow = partitionsDf
                .agg(max(col("date")).alias("max_date"))
                .first();

        java.sql.Date maxDate = maxDateRow.getDate(0);
        String maxDateStr = maxDate.toString();

        String latestPath = basePath + "/*/date=" + maxDateStr + "/";

        Dataset<Row> dfLatest = spark.read()
                .option("basePath", basePath)
                .option("header", "true")
                .option("inferSchema", "true")
                .csv(latestPath);

        dfLatest.show(false);

        spark.stop();
    }
}