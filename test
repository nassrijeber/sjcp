package com.cacib.ted.integration.processor.custom;

import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;
import org.apache.spark.sql.SparkSession;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedHashMap;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

public final class SqlJavaWithColumnsBuilder {

    /**
     * Séparateur entre le nom de colonne cible et l'expression SQL.
     * Exemple :
     * my_col ::= COALESCE(a, b)
     */
    private static final String OVERRIDE_SEPARATOR = "::=";

    /**
     * Séparateur entre deux règles.
     * Exemple :
     * col1 ::= expr1
     * @@@
     * col2 ::= expr2
     */
    private static final String COLUMN_SEPARATOR = "@@@";

    private static final String SQL_TEMPLATE = "SELECT %s FROM %s";
    private static final String COLUMN_ALIAS_TEMPLATE = "%s AS %s";

    private SqlJavaWithColumnsBuilder() {
    }

    public static Dataset<Row> applyWithColumns(
            SparkSession spark,
            Dataset<Row> sourceDf,
            String tempViewName,
            String overrideBlock
    ) {
        Map<String, String> overrides = parseWithColumns(overrideBlock);

        List<String> selectExpressions = new ArrayList<>();
        Set<String> existingColumns = new LinkedHashSet<>(Arrays.asList(sourceDf.columns()));

        // 1) Colonnes existantes : on garde ou on remplace
        for (String sourceColumn : sourceDf.columns()) {
            String expression = overrides.get(sourceColumn);
            selectExpressions.add(buildSelectExpression(sourceColumn, expression));
        }

        // 2) Nouvelles colonnes : on les ajoute à la fin
        for (Map.Entry<String, String> entry : overrides.entrySet()) {
            String targetColumn = entry.getKey();
            String expression = entry.getValue();

            if (!existingColumns.contains(targetColumn)) {
                selectExpressions.add(buildSelectExpression(targetColumn, expression));
            }
        }

        String selectClause = String.join(",\n    ", selectExpressions);
        String sql = SQL_TEMPLATE.formatted(selectClause, tempViewName);

        return spark.sql(sql);
    }

    private static String buildSelectExpression(String targetColumn, String expression) {
        if (expression == null || expression.isBlank()) {
            return targetColumn;
        }

        String trimmedExpression = expression.trim();

        // Si l'expression se termine déjà par "AS alias", on la garde telle quelle.
        if (hasFinalAlias(trimmedExpression)) {
            return trimmedExpression;
        }

        return COLUMN_ALIAS_TEMPLATE.formatted(trimmedExpression, targetColumn);
    }

    /**
     * Détecte uniquement un alias final du type :
     *   expr AS my_col
     * ou
     *   expr AS `my_col`
     *
     * Cela évite de confondre avec :
     *   CAST(x AS STRING)
     */
    private static boolean hasFinalAlias(String expression) {
        String normalized = expression.trim().replaceAll("\\s+", " ");

        return normalized.matches("(?i)^.+\\s+AS\\s+(`[^`]+`|[a-zA-Z_][a-zA-Z0-9_]*)$");
    }

    private static Map<String, String> parseWithColumns(String block) {
        Map<String, String> result = new LinkedHashMap<>();

        if (block == null || block.isBlank()) {
            return result;
        }

        String[] entries = block.split("(?s)\\s*" + java.util.regex.Pattern.quote(COLUMN_SEPARATOR) + "\\s*");

        for (String entry : entries) {
            String trimmedEntry = entry.trim();

            if (trimmedEntry.isEmpty()) {
                continue;
            }

            int separatorIndex = trimmedEntry.indexOf(OVERRIDE_SEPARATOR);
            if (separatorIndex < 0) {
                throw new IllegalArgumentException(
                        "Invalid withColumns entry. Missing separator '" + OVERRIDE_SEPARATOR + "' in:\n" + trimmedEntry
                );
            }

            String targetColumn = trimmedEntry.substring(0, separatorIndex).trim();
            String expression = trimmedEntry.substring(separatorIndex + OVERRIDE_SEPARATOR.length()).trim();

            if (targetColumn.isEmpty()) {
                throw new IllegalArgumentException(
                        "Invalid withColumns entry. Empty target column in:\n" + trimmedEntry
                );
            }

            if (expression.isEmpty()) {
                throw new IllegalArgumentException(
                        "Invalid withColumns entry. Empty SQL expression for column: " + targetColumn
                );
            }

            result.put(targetColumn, expression);
        }

        return result;
    }
}