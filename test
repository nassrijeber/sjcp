import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;
import org.apache.spark.sql.SparkSession;

import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class SqlOverrideBuilder {

    public static Dataset<Row> applyOverrides(
            SparkSession spark,
            Dataset<Row> df,
            String tempView,
            String overrideBlock
    ) {
        df.createOrReplaceTempView(tempView);

        Map<String, String> overrides = parseOverrideBlock(overrideBlock);

        List<String> selectParts = new ArrayList<>();
        for (String col : df.columns()) {
            selectParts.add(overrides.getOrDefault(col, col));
        }

        String finalSql =
                "SELECT\n    " +
                String.join(",\n    ", selectParts) +
                "\nFROM " + tempView;

        System.out.println(finalSql);

        return spark.sql(finalSql);
    }

    private static Map<String, String> parseOverrideBlock(String overrideBlock) {
        Map<String, String> result = new HashMap<>();

        Pattern aliasPattern = Pattern.compile("(?i)\\bAS\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*$");

        String[] lines = overrideBlock.split("\\r?\\n");
        for (String rawLine : lines) {
            String line = rawLine.trim();

            if (line.isEmpty()) {
                continue;
            }

            if (line.endsWith(",")) {
                line = line.substring(0, line.length() - 1).trim();
            }

            Matcher matcher = aliasPattern.matcher(line);
            if (!matcher.find()) {
                throw new IllegalArgumentException("Alias introuvable dans : " + line);
            }

            String colName = matcher.group(1);
            result.put(colName, line);
        }

        return result;
    }
}