import org.apache.spark.sql.Dataset;
import org.apache.spark.sql.Row;
import org.apache.spark.sql.SparkSession;

import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

public final class SparkSqlCaseWhenOverrideBuilder {

    private static final Pattern ALIAS_PATTERN =
            Pattern.compile("(?i)\\bAS\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*$");

    private SparkSqlCaseWhenOverrideBuilder() {
    }

    /**
     * Construit un SELECT SQL complet en remplaçant uniquement
     * les colonnes présentes dans le bloc override.
     *
     * @param spark         SparkSession
     * @param sourceDf      DataFrame source
     * @param tempViewName  nom de la vue temporaire
     * @param overrideBlock bloc SQL contenant des CASE WHEN séparés par des virgules
     * @return Dataset<Row> résultat du SQL généré
     */
    public static Dataset<Row> applyOverrides(
            SparkSession spark,
            Dataset<Row> sourceDf,
            String tempViewName,
            String overrideBlock
    ) {
        sourceDf.createOrReplaceTempView(tempViewName);

        Map<String, String> overridesByColumn = parseOverrideBlock(overrideBlock);

        List<String> finalSelectParts = new ArrayList<>();

        for (String colName : sourceDf.columns()) {
            String overrideExpression = overridesByColumn.get(colName);
            if (overrideExpression != null) {
                finalSelectParts.add(overrideExpression);
            } else {
                finalSelectParts.add("src." + colName);
            }
        }

        String finalSql =
                "SELECT\n    " +
                String.join(",\n    ", finalSelectParts) +
                "\nFROM " + tempViewName + " src";

        System.out.println("========== GENERATED SQL ==========");
        System.out.println(finalSql);
        System.out.println("===================================");

        return spark.sql(finalSql);
    }

    /**
     * Parse un bloc SQL de ce type :
     *
     * CASE WHEN ... THEN ... ELSE ... END AS col_1,
     * CASE WHEN ... THEN ... ELSE ... END AS col_2,
     * CASE WHEN ... THEN ... ELSE ... END AS col_3
     *
     * Le split est volontairement simple : séparation par virgule.
     */
    private static Map<String, String> parseOverrideBlock(String overrideBlock) {
        Map<String, String> overrides = new LinkedHashMap<>();

        if (overrideBlock == null || overrideBlock.trim().isEmpty()) {
            return overrides;
        }

        String[] expressions = overrideBlock.split(",");

        for (String rawExpr : expressions) {
            String expr = rawExpr.trim();

            if (expr.isEmpty()) {
                continue;
            }

            Matcher matcher = ALIAS_PATTERN.matcher(expr);
            if (!matcher.find()) {
                throw new IllegalArgumentException(
                        "Alias introuvable dans l'expression suivante : " + expr
                );
            }

            String alias = matcher.group(1);
            overrides.put(alias, expr);
        }

        return overrides;
    }
}